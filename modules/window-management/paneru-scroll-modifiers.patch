+            (Modifiers::SHIFT, 0x0002_0000),
+            (Modifiers::CTRL, 0x0004_0000),
+            (Modifiers::CMD, 0x0010_0000),
+        ] {
+            assert!(group.matches(get_scroll_modifiers(CGEventFlags(flag))));
+        }
+    }
